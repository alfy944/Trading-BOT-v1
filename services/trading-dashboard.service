[Unit]
Description=Trading Bot Dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/Trading-BOT-v1
EnvironmentFile=/home/ubuntu/Trading-BOT-v1/.env
ExecStart=/home/ubuntu/Trading-BOT-v1/venv-trading-bot/bin/python /home/ubuntu/Trading-BOT-v1/dashboard.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
